#question 3 part A
def find_dup_str(s, n):
    """
    The first duplicated substring of length n in s will be returned,
    """
    length = len(s)

    # If index is longer than the string itself, no duplicates can exist
    if n <= 0 or n > length:
        return ""

    # Test all starting position i for the first substring
    for i in range(length - n + 1):
        sub = s[i:i+n]


        for j in range(i + n, length - n + 1):  # j begins at i+n to avoid overlapping substrings
            if s[j:j+n] == sub:
                return sub

    return ""

#question 3 part B
def find_max_dup(s):
    """Return the longest duplicated substring in s."""
    length = len(s)
    for n in range(length, 0, -1):
        dup = find_dup_str(s, n)
        if dup != "":
            return dup
    return ""

s = input("Enter a string: ")
result = find_max_dup(s)
print("Longest duplicated substring:", result)
